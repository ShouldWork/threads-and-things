{
  "name": "threads-and-things",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --config test/vite.config.ts",
    "dev:emu": "vite --mode emulator",
    "emulators": "firebase emulators:start --only auth,firestore",
    "test": "vitest run --exclude test/rules.test.ts",
    "test:rules": "vitest run test/rules.test.ts",
    "test:browser": "playwright test",
    "check": "npm test && npm run build",
    "build": "tsc --noEmit && vite build",
    "build:preview": "tsc --noEmit && vite build --config test/vite.config.ts --mode preview",
    "preview": "vite preview",
    "deploy": "npm run check && firebase deploy --only firestore,hosting",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/react": "^16.3.0",
    "@playwright/test": "^1.56.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "engines": { "node": ">=22.12.0" },
  "overrides": { "@grpc/grpc-js": "^1.14.6" }
}
